{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "tsx --env-file=../.env src/db/migrate-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval:seed": "tsx --env-file=../.env evals/seed.ts",
    "eval:retrieval": "tsx --env-file=../.env evals/retrieval.eval.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "pg": "^8.13.0",
    "pg-boss": "^12.38.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "unpdf": "^1.9.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
