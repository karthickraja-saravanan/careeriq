# --- Database ---
DATABASE_URL=postgres://careeriq:careeriq@localhost:5432/careeriq

# --- API ---
PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=5242880
EMBEDDING_CACHE_DIR=./.models   # embedding model is downloaded here on first use (~130 MB)

# --- LLM (used from M3 onwards) ---
LLM_PROVIDER=groq            # groq | ollama
GROQ_API_KEY=                # create at console.groq.com, never commit
LLM_MODEL_MAIN=llama-3.3-70b-versatile
LLM_MODEL_FAST=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://localhost:11434/v1
